FROM python:3.13-bookworm

WORKDIR /app

ENV VIRTUAL_ENV=/app/.venv
ENV PATH="$VIRTUAL_ENV/bin:$PATH"

RUN python -m venv $VIRTUAL_ENV
RUN pip install uv
RUN apt-get update && apt-get install -y supervisor && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml uv.lock ./
COPY common/ common/
COPY engine/ engine/
COPY server/ server/
COPY docker/server-supervisord.dev.conf /etc/supervisor/conf.d/server.conf

RUN cd server && uv sync --frozen

ENV PYTHONPATH="$VIRTUAL_ENV/lib/python3.13/site-packages:/app"
ENV PREFECT_WORK_POOL=orbitx-worker-pool

WORKDIR /app/server

EXPOSE 8080

CMD ["supervisord", "-n", "-c", "/etc/supervisor/conf.d/server.conf"]
